#!/bin/bash
# validate and build TypeScript app

APP_DIR="$1"

if [ -z "$APP_DIR" ]; then
    echo "Usage: validate <app_directory>"
    exit 1
fi

if [ ! -d "$APP_DIR" ]; then
    echo "Error: Directory '$APP_DIR' does not exist"
    exit 1
fi

cd "$APP_DIR" || exit 1

echo "Installing dependencies..."
npm install --silent

echo "Type checking..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
    echo "Type check failed - fix TypeScript errors above"
    exit 1
fi

echo "Building..."
npm run build
if [ $? -ne 0 ]; then
    echo "Build failed"
    exit 1
fi

echo "Validation passed!"
